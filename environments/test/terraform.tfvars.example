# Copy to terraform.tfvars (git-ignored). IDENTITY ONLY: shared settings live in environments/common.tfvars.

organization_name = "<short-org-name>"
environment       = "test"
owner             = "Platform Engineering"
cost_center       = "LAB001"

# Landing Zone state location: the Landing Zone output "terraform_state" prints these three values.
landing_zone_state_bucket = "<landing-zone-state-bucket>"
landing_zone_state_key    = "landing-zone/test/terraform.tfstate"
landing_zone_state_region = "<landing-zone-state-bucket-region>"

# Source: a CodeConnections connection created in eu-west-1 (scripts/setup-github-connection.sh) and approved in the console
repository_name       = "<github-user>/<application-repository>"
branch_name           = "main"
github_connection_arn = "<connection-arn-in-eu-west-1>"

# Pipeline artifact bucket (globally unique name, created in eu-west-1)
artifact_bucket_name = "<org>-test-pipeline-artifacts"

# Deployment targets. Leave empty to deploy into the Landing Zone account itself.
# dev_account_id  = "<12-digit-account-id>"
# test_account_id = "<12-digit-account-id>"
# prod_account_id = "<12-digit-account-id>"

# Optional notifications
# pipeline_notification_email = "<address>"
# approval_notification_email = "<address>"
# slack_webhook_secret_arn    = "<secrets-manager-arn>"
